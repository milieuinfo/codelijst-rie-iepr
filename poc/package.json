{
  "name": "codelijst-rie-iepr-poc",
  "version": "0.1.0",
  "description": "Proof of Concept Web UI for RIE-IEPR codelists",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-codelist.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-codelist.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{ts,js}' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.{ts,js}' --fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@domg-wc/components": "2.16.0",
    "@domg-wc/styles": "2.16.0",
    "@domg/govflanders-style": "21.3.0",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitest/browser": "^3.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-jsdoc": "^48.10.1",
    "eslint-plugin-lit": "^1.15.0",
    "happy-dom": "^16.7.0",
    "typescript": "~5.8.0",
    "vite": "~6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.1.8",
    "workbox-build": "^7.3.0"
  },
  "main": "vite.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
