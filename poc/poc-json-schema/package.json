{
  "name": "codelijst-rie-iepr-poc-json-schema",
  "version": "0.1.0",
  "description": "Transformation tool that generates JSON Schema (Draft 2020-12) from RIE-IEPR SKOS/JSON-LD codelist",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "predev": "node scripts/sync-codelist.mjs",
    "build": "tsc",
    "generate": "node dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.15.17",
    "typescript": "~5.8.0",
    "vitest": "^3.1.8"
  }
}
