{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.riepr.omgeving.vlaanderen.be/schema/2026/observatie/lucht/schema.json",
  "description": "RIE-IEPR observatie voor lucht",
  "type": "object",
  "required": ["resultTime", "observedProperty", "hasFeatureOfInterest", "hasResult"],
  "properties": {
    "resultTime": {
      "$ref": "https://data.riepr.omgeving.vlaanderen.be/schema/2026/observatie/observatie.json#/properties/resultTime"
    },
    "wasOriginatedBy": {
      "$ref": "https://data.riepr.omgeving.vlaanderen.be/schema/2026/observatie/observatie.json#/properties/wasOriginatedBy"
    },
    "hasFeatureOfInterest": {
      "type": "string",
      "allOf": [
        {
          "$ref": "https://data.riepr.omgeving.vlaanderen.be/schema/2026/observatie/observatie.json#/properties/hasFeatureOfInterest"
        }
      ]
    },
    "observedProperty": {
      "type": "string",
      "allOf": [
        {
          "$ref": "https://data.riepr.omgeving.vlaanderen.be/schema/2026/observatie/observatie.json#/properties/observedProperty"
        },
        {
          "enum": [
            "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/relatieveVochtigheid",
            "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/temperatuur"
          ]
        }
      ]
    },
    "hasResult": {
      "allOf": [
        {
          "$ref": "https://data.riepr.omgeving.vlaanderen.be/schema/2026/observatie/observatie.json#/properties/hasResult"
        },
        {
          "type": "object",
          "properties": {
            "hasUnit": {
              "enum": [
                "http://qudt.org/vocab/unit/PERCENT",
                "http://qudt.org/vocab/unit/K",
                "http://qudt.org/vocab/unit/DEG_C"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "https://data.riepr.omgeving.vlaanderen.be/schema/2026/observatie/observatie.json"
    },
    {
      "if": {
        "properties": {
          "observedProperty": {
            "const": "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/relatieveVochtigheid"
          }
        }
      },
      "then": {
        "properties": {
          "hasResult": {
            "type": "object",
            "properties": {
              "numericValue": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "hasUnit": {
                "const": "http://qudt.org/vocab/unit/PERCENT"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observedProperty": {
            "const": "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/temperatuur"
          }
        }
      },
      "then": {
        "properties": {
          "hasResult": {
            "type": "object",
            "required": [
              "hasUnit"
            ],
            "properties": {
              "hasUnit": {
                "enum": [
                  "http://qudt.org/vocab/unit/K",
                  "http://qudt.org/vocab/unit/DEG_C"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
