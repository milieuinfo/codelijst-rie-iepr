@prefix comp-riepr: <https://data.omgeving.vlaanderen.be/id/dsd/riepr/operationeel-contextueel/productievolume#component-https%3A%2F%2Fdata.riepr.omgeving.vlaanderen.be%2Fns%2Friepr%23>.
@prefix comp-qudt: <https://data.omgeving.vlaanderen.be/id/dsd/riepr/operationeel-contextueel/productievolume#component-http%3A%2F%2Fqudt.org%2Fschema%2Fqudt%2F>.
@prefix contextueel: <https://data.omgeving.vlaanderen.be/id/concept/riepr/operationeel-contextueel/>.
@prefix dsd: <https://data.omgeving.vlaanderen.be/id/dsd/riepr/operationeel-contextueel/>.
@prefix riepr: <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix qb: <http://purl.org/linked-data/cube#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix qudt: <http://qudt.org/schema/qudt/>.
@prefix time: <http://www.w3.org/2006/time#>.
@prefix sosa-2023: <http://www.w3.org/ns/sosa/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

dsd:productievolume a qb:DataStructureDefinition;
    dcterms:source contextueel:productievolume;
    rdfs:label "Productievolume"@nl;
    dcterms:description "Totale productie (geheel getal)"@nl;
    qb:component comp-riepr:bronObservatie,
        comp-riepr:referentieObject,
        comp-riepr:verslagjaar,
        comp-qudt:numericValue,
        comp-riepr:meetmoment,
        comp-riepr:meetperiode.

comp-riepr:bronObservatie a qb:ComponentSpecification;
    dcterms:source riepr:bronObservatie;
    rdfs:label "Bronobservatie"@nl;
    qb:dimension riepr:bronObservatie;
    qb:order 1.

riepr:bronObservatie a rdf:Property,
        qb:DimensionProperty;
    rdfs:range sosa-2023:Observation.

comp-riepr:referentieObject a qb:ComponentSpecification;
    dcterms:source riepr:referentieObject;
    rdfs:label "Referentieobject"@nl;
    qb:dimension riepr:referentieObject;
    qb:order 2.

riepr:referentieObject a rdf:Property,
        qb:DimensionProperty;
    rdfs:range sosa-2023:FeatureOfInterest.

comp-riepr:verslagjaar a qb:ComponentSpecification;
    dcterms:source riepr:verslagjaar;
    rdfs:label "Verslagjaar"@nl;
    qb:dimension riepr:verslagjaar;
    qb:order 3.

riepr:verslagjaar a rdf:Property,
        qb:DimensionProperty;
    rdfs:range xsd:gYear.

comp-qudt:numericValue a qb:ComponentSpecification;
    dcterms:source contextueel:productievolume;
    rdfs:label "Productievolume"@nl;
    qb:measure qudt:numericValue.

qudt:numericValue a rdf:Property,
        qb:MeasureProperty;
    rdfs:range xsd:decimal.

comp-riepr:meetmoment a qb:ComponentSpecification;
    dcterms:source riepr:meetmoment;
    rdfs:label "Meetmoment"@nl;
    qb:attribute riepr:meetmoment;
    qb:componentAttachment qb:Observation;
    qb:componentRequired false.

riepr:meetmoment a rdf:Property,
        qb:AttributeProperty;
    rdfs:range rdfs:Literal.

comp-riepr:meetperiode a qb:ComponentSpecification;
    dcterms:source riepr:meetperiode;
    rdfs:label "Meetperiode"@nl;
    qb:attribute riepr:meetperiode;
    qb:componentAttachment qb:Observation;
    qb:componentRequired false.

riepr:meetperiode a rdf:Property,
        qb:AttributeProperty;
    rdfs:range time:TemporalEntity.
