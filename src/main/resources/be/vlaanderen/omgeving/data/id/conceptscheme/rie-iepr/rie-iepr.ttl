concept:lucht-indicatieofeenemissievracht dcterms:created "2026-07-09T12:41:43.845Z"^^xsd:dateTime;
    qudt:relevantUnit unit:KILO_GRAM;
    a skos:Concept;
    skos:broader <riepr-lucht:jaar-emissie>;
    skos:broaderTransitive <riepr-lucht:jaar-emissie>;
    skos:definition "een indicatie of een emissievracht geleide, niet-geleide of abnormaal (=OTNOCs) emissie betreft"@nl;
    skos:inScheme conceptscheme:operationeel_lucht;
    skos:notation "lucht-lucht-indicatieofeenemissievracht";
    skos:note "een indicatie of een emissievracht geleide, niet-geleide of abnormaal (=OTNOCs) emissie betreft"@nl, "voor alle emissies; bij productie-eenheden zijn er voor niet-geleide: lekverliezen en andere verliezen, en wordt voor \"andere\" de oorzaak opgevraagd; bij op/overslag kunnen er opslag emissies of overslag emissies zijn, ongeacht of het een op- of overslag installatie is; opslag verlies is bv. ademverlies; overslagemissie is bv. bij vullen of ledigen; abnormaal bij fakkel zou zijn als de fakkel bv. niet of niet optimaal werkt. Bij stookinstallaties zijn er geen niet-geleide emissies."@nl;
    skos:prefLabel "Indicatie of een emissievracht"@nl;
    skos:scopeNote "voor alle emissies; bij productie-eenheden zijn er voor niet-geleide: lekverliezen en andere verliezen, en wordt voor \"andere\" de oorzaak opgevraagd; bij op/overslag kunnen er opslag emissies of overslag emissies zijn, ongeacht of het een op- of overslag installatie is; opslag verlies is bv. ademverlies; overslagemissie is bv. bij vullen of ledigen; abnormaal bij fakkel zou zijn als de fakkel bv. niet of niet optimaal werkt. Bij stookinstallaties zijn er geen niet-geleide emissies."@nl;
    skos:semanticRelation <riepr-lucht:jaar-emissie>;
    adms:status <https://purl.archive.org/adms/status/Active>;
    riepr-vocab:relevantCodeList conceptscheme:emissietype;
    riepr-vocab:relevantDataType xsd:string.
