@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix iso25964: <http://purl.org/iso25964/skos-thes#> .
@prefix riepr: <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .

{
    ?code skos:inScheme ?codelijst .
    ?codelijst dcterms:isPartOf ?verzameling .
} => {
    ?code dcterms:isPartOf ?verzameling .
} .

{
    ?child iso25964:broaderPartitive ?parent .
} => {
    ?parent iso25964:narrowerPartitive ?child .
} .

{
    ?eigenschap <https://data.riepr.omgeving.vlaanderen.be/ns/vocab#relevantRiepr> ?type .
    ?type skos:narrower ?subtype .
} => {
    ?eigenschap <https://data.riepr.omgeving.vlaanderen.be/ns/vocab#relevantRiepr> ?subtype .
} .
